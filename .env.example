# Copy this file to .env. EVERYTHING here is optional: with no key the site and chatbot still work (offline engine).
ANTHROPIC_API_KEY=paste-your-key-here
# auto  = use Claude if a key is set, fall back to the offline engine if the API fails (default)
# local = never call the API (free, no key needed)
# claude = prefer Claude (still falls back if the API fails)
CHAT_MODE=auto
MODEL=claude-haiku-5-5
PORT=5000

# --- Abuse protection (defaults shown) ---
# Max chat requests per visitor IP per minute
RATE_LIMIT_PER_MIN=30
# Max Claude calls per server instance per day; after that the free offline engine answers
DAILY_CLAUDE_LIMIT=300
# Seconds to wait for Claude before falling back (keep below the host's maxDuration, 30 s in vercel.json)
CLAUDE_TIMEOUT=10
# Set to 1 ONLY behind a trusted proxy/host so the real visitor IP is used for rate limiting (automatic on Vercel)
TRUST_PROXY=
